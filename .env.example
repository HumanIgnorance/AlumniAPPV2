# Copy to .env on the server and fill in real values. NEVER commit .env.
APP_NAME="Alumni Tracer"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # php artisan key:generate
APP_URL=https://YOURDOMAIN
FRONTEND_URL=https://YOURDOMAIN

# Transport / cookies
FORCE_HTTPS=true
SESSION_SECURE_COOKIE=true
SESSION_DRIVER=database
CACHE_DRIVER=file

# Security headers: set false once the app is tested in a browser with no CSP errors
CSP_REPORT_ONLY=false

# Hashing
BCRYPT_ROUNDS=12

# Logging / alerts
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_SECURITY_CHANNEL=security
LOG_SLACK_WEBHOOK_URL=        # optional: security alerts to Slack

# Database (use a dedicated low-privilege user; do not expose port 3306 publicly)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Mail
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_TO_EMAIL=             # inbox for the public contact form

# Firebase (path to a credentials file stored OUTSIDE the web root)
FIREBASE_CREDENTIALS=
